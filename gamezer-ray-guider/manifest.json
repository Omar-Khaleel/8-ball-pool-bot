{
  "manifest_version": 3,
  "name": "Gamezer Ray Guider",
  "version": "0.2.0",
  "description": "Minimal Gamezer guider. Hover the cue ball and press C; no click is required.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://gamezer.com/*",
        "https://*.gamezer.com/*",
        "http://gamezer.com/*",
        "http://*.gamezer.com/*"
      ],
      "js": [
        "physics.js",
        "gamezer-guider.js",
        "compatibility.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
