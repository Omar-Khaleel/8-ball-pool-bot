{
  "manifest_version": 3,
  "name": "Gamezer Snapshot Guider",
  "version": "0.3.0",
  "description": "Minimal two-line Gamezer guider using one browser snapshot per layout. Hover the cue ball and press C.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Arm Gamezer Snapshot Guider"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gamezer.com/*",
        "https://*.gamezer.com/*",
        "http://gamezer.com/*",
        "http://*.gamezer.com/*"
      ],
      "js": [
        "physics.js",
        "snapshot-guider.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
